# p2 — Vagrantfile
# 1 VM : <login>S (192.168.56.110, K3s server). Provider VirtualBox.
# A ecrire toi-meme : voir guide-p2.md (section 1).
# TODO
Vagrant.configure("2") do |config|
    config.vm.box = "bento/ubuntu-22.04"

    config.vm.define "artbernaS" do |server|
        server.vm.hostname = "artbernaS"
        server.vm.network "private_network", ip: "192.168.56.110"
        server.vm.provider "virtualbox" do |vb|
            vb.memory = "1024"
            vb.cpus = 1
            vb.name = "artbernaS"
        end
        server.vm.provision "shell", path: "./scripts/server.sh"
    end
end